#  Database 
# Docker: postgres://postgres:postgres@localhost:5432/form_builder
DATABASE_URL=postgres://postgres:postgres@localhost:5432/form_builder

#  API server 
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

#  Google OAuth 
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

#  Email (Resend)
# Get API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=WebForm <noreply@yourdomain.com>

#  Logger
LOG_LEVEL=debug

#  Web (Next.js)
# tRPC calls go through Next.js proxy — no explicit URL needed in dev
# Internal URL Next.js uses to reach the API (server-side proxy)
API_INTERNAL_URL=http://localhost:8080
# WebSocket — must be accessible from the browser
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
